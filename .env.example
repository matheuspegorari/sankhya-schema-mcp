# Como o MCP chega ao banco. OBRIGATÓRIO, sem padrão: a subida falha se faltar.
#   direct = conecta no banco pelo driver (Oracle ou SQL Server). Usa SANKHYA_DB_*.
#   dbe    = não conecta no banco: faz login no Sankhya (MobileLoginSP.login) e manda
#            toda consulta pelo DB Explorer. Útil quando só a porta HTTP do Sankhya é
#            alcançável. Só SELECT/WITH, até 5000 linhas por consulta, sem EXPLAIN
#            PLAN. Usa SANKHYA_DBE_* (ao fim deste arquivo).
SANKHYA_MODE=direct

# Banco de destino: oracle (padrão) ou sqlserver. Vale nos dois modos: o SQL é
# escrito para o banco que está por trás.
SANKHYA_DB_TYPE=oracle

SANKHYA_DB_HOST=localhost
SANKHYA_DB_PORT=1521
SANKHYA_DB_USER=SANKHYA
SANKHYA_DB_PASSWORD=developer

# Schema onde as tabelas do Sankhya moram, quando não é o do usuário conectado.
# Necessário sempre que o login do MCP (tipicamente um usuário somente-leitura)
# não é o dono das tabelas: sem isso, table_sample e search_entities respondem
# "objeto não existe" e a tradução de EntityName para nome de tabela para de
# funcionar. Vale nos dois bancos. Ausente = nome de tabela não é qualificado.
# SANKHYA_DB_SCHEMA=SANKHYA

# --- Oracle -----------------------------------------------------------------
# Conexão por SID (padrão). Use SANKHYA_DB_SERVICE_NAME para conectar por service name.
SANKHYA_DB_SERVICE=XE
# tem precedência sobre o SID quando informado
# SANKHYA_DB_SERVICE_NAME=ORCLPDB1

# --- SQL Server -------------------------------------------------------------
# SQL Server endereça database, não SID/service name. Ignorado quando o tipo é oracle.
# Exige o driver: pip install -r requirements-sqlserver.txt
# SANKHYA_DB_TYPE=sqlserver
# SANKHYA_DB_PORT=1433
# SANKHYA_DB_DATABASE=jiva

# --- Modo DBE ----------------------------------------------------------------
# Só com SANKHYA_MODE=dbe. As variáveis SANKHYA_DB_HOST/PORT/USER/PASSWORD não são
# usadas nesse modo; SANKHYA_DB_TYPE e SANKHYA_DB_SCHEMA continuam valendo.
# SANKHYA_DBE_URL=http://sankhya.exemplo.com.br:8380
# SANKHYA_DBE_USER=usuario_sankhya
# SANKHYA_DBE_PASSWORD=senha_sankhya

# --- Vários clientes ----------------------------------------------------------
# Em qualquer modo, cadastre os clientes em `clients.json` (modelo:
# clients.example.json) em vez das variáveis acima: cada cliente com o seu banco.
# O modo (SANKHYA_MODE) escolhe qual credencial de cada cliente vale. Para um
# arquivo em outro lugar, por projeto:
# SANKHYA_CLIENTS_FILE=/caminho/para/clients.json
